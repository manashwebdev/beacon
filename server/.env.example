# Port the API listens on
PORT=4000
# MongoDB Atlas free cluster connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/beacon?retryWrites=true&w=majority
# Long random string used to sign sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Optional: comma-separated origins allowed to call the API directly from a browser (CORS).
# Not needed when the client proxies /api through Next.js, which is the default setup.
CLIENT_URL=http://localhost:3000
# Optional: key used to encrypt GitHub tokens saved by users. Falls back to JWT_SECRET when empty.
ENCRYPTION_KEY=
# Recommended: one GitHub token for the whole site, used for the public lookup at /github.
# Create a fine-grained token with "Public repositories" access and no extra permissions. Without it, GitHub allows only 60 lookups per hour.
GITHUB_TOKEN=
